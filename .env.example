# No credentials are required for the explicitly labelled fictional demo.
# Production mode is selected ONLY when DATABASE_URL is set.
DATABASE_URL=
# Required for live search: a long random workspace token, never exposed in source.
APP_ACCESS_TOKEN=
# Separate token (at least 32 characters) for ingestion and administrative writes.
INGEST_TOKEN=
OPENAI_API_KEY=
# Fixed embedding model + dimension contract. Changing it requires re-indexing.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional grounded synthesis. Leave blank for extractive, citation-backed briefs.
OPENAI_CHAT_MODEL=
# Optional cross-encoder; local evidence-aware reranking works without it.
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
FIRECRAWL_API_KEY=
# Exact permitted career-site hostnames; no wildcards. Example: careers.example.org
SCRAPE_ALLOWED_HOSTS=
# Daily maximum paid searches per workspace, enforced atomically in PostgreSQL.
DAILY_SEARCH_LIMIT=250
# A source is no longer searchable after this many days without a successful sync.
SOURCE_FRESH_DAYS=14
